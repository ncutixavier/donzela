# Copy to `.env` in the project root and fill in the values from the Firebase
# console (Project settings > Your apps) and Google Cloud (Credentials).
# `.env` is gitignored. In CI the same names come from GitHub secrets.
#
# Then run:  dart run tool/generate_firebase_config.dart

# Project
FIREBASE_PROJECT_ID=donzela
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Android app (package health.donzela.donzela)
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_CLIENT_ID=

# iOS app (bundle health.donzela.donzela)
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_CLIENT_ID=

# Google sign-in: the web client (client_type 3 in google-services.json)
GOOGLE_WEB_CLIENT_ID=
